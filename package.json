{
  "name": "player-training-offline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "simulate:contract": "node scripts/run-contract.mjs simulate",
    "simulate:economy": "node scripts/run-contract.mjs economy",
    "debug:template": "node scripts/run-contract.mjs match",
    "audit:templates": "node scripts/run-contract.mjs audit",
    "audit:template-proposal": "node scripts/audit-template-proposal.mjs",
    "search:templates": "node scripts/run-contract.mjs audit-search",
    "preview": "vite preview",
    "assets:export": "node scripts/prepare-assets.mjs --export",
    "prebuild": "node scripts/prepare-assets.mjs",
    "postbuild": "node scripts/copy-runtime-assets.mjs",
    "assets:verify": "node scripts/verify-cdn-assets.mjs",
    "audit:template-expansion": "node scripts/calibrate-templates.mjs",
    "scan:template-expansion": "node scripts/scan-template-expansion.mjs"
  },
  "dependencies": {
    "preact": "10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tinypool": "^2.1.2"
  }
}
