# Public frontend build configuration: no secrets belong in VITE_* variables.
VITE_GYM_AUTHORITY_API_BASE=https://YOUR-VERIFIED-ACTIVITY-GATEWAY/api
VITE_GYM_AUTHORITY_ENV_ID=YOUR-ACTIVITY-ENVIRONMENT

# Trusted backend runtime only. Put actual values in server secure configuration.
SHAPER_TOKEN=
TIMEFLOW_BASE_URL=https://relay.hupu.com
GYM_AUTHORITY_ENVIRONMENT=
CLOUDBASE_ENV_ID=
COLORBOX__ACCESS_KEY=
BUSINESS_ACTIVITY_ID=app_847cdb589a
# Official CloudBase gateway integration; gateway verification is required.
GYM_AUTHORITY_AUTH_MODE=cloudbase-gateway
# Alternative trusted host only; no custom auth module is required for CloudBase.
# GYM_AUTHORITY_AUTH_MODULE=
GYM_AUTHORITY_ALLOWED_ORIGIN=
GYM_AUTHORITY_MODE=production

# Local single-process development only; never use these for production identity.
# GYM_AUTHORITY_MODE=development
# GYM_DEV_SESSION=replace-with-a-random-local-session-of-at-least-16-characters
# GYM_AUTHORITY_DATA_DIR=.tmp/gym-authority-data
